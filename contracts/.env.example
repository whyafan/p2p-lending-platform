# ─── Sepolia testnet deployment ───────────────────────────────────────────────
# Private key of the deployer wallet (no 0x prefix needed by Hardhat).
# NEVER commit the real .env file — keep this key in .env only.
SEPOLIA_PRIVATE_KEY=your-sepolia-private-key

# Sepolia RPC — get a free key from Alchemy or Infura, or use the public endpoint.
SEPOLIA_RPC_URL=https://sepolia.drpc.org

