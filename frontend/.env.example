# Copy this file to .env.local and fill in the secrets marked with YOUR_...
# Everything else is pre-filled and shared across the team.

# ─── Network ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_NETWORK_MODE=testnet

# ─── Sepolia testnet (chain 11155111) ─────────────────────────────────────────
# Deployed 2026-05-18 via: cd contracts && npx hardhat ignition deploy ignition/modules/NexusFiMilestone1.ts --network sepolia
NEXT_PUBLIC_LOAN_FACTORY_ADDRESS_SEPOLIA=0x0e3ea8f226434feadb267d05c9c4ef8f951c7d00
NEXT_PUBLIC_COLLATERAL_VAULT_ADDRESS_SEPOLIA=0x99Cb30A1e862f817b7702432f3B409825Ed5cA09
NEXT_PUBLIC_MOCK_PRICE_FEED_ADDRESS_SEPOLIA=0xC6faac19a11B7057AD42ce69429717f6AA7CEb3a

# Public Sepolia RPC (no key required). Swap for your own Alchemy/Infura URL for better rate limits.
NEXT_PUBLIC_RPC_URL_SEPOLIA=https://rpc.sepolia.org

# ─── Local Hardhat (chain 31337) — only needed when NEXT_PUBLIC_NETWORK_MODE=local ──
NEXT_PUBLIC_RPC_URL_LOCAL=http://127.0.0.1:8545
NEXT_PUBLIC_LOAN_FACTORY_ADDRESS_LOCAL=0xYourLocalLoanFactoryAddress

# ─── Supabase (auth + KYC) ────────────────────────────────────────────────────
# These are public/anon credentials — safe to share.
NEXT_PUBLIC_SUPABASE_URL=https://nnlmotaaetojwxjqamay.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5ubG1vdGFhZXRvand4anFhbWF5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg4NDcyMzEsImV4cCI6MjA5NDQyMzIzMX0.xQJ_yzbT80906FrWKOZ0J7VK7LNba5hTcE72Ijgjk1E

# Server-only secret — get from Supabase dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ─── WalletConnect (optional — enables Trust Wallet / mobile wallets) ─────────
# Create a free project at https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# ─── Didit KYC (optional — for identity verification) ────────────────────────
# From https://didit.me/ dashboard
DIDIT_API_KEY=YOUR_DIDIT_API_KEY
DIDIT_WORKFLOW_ID=YOUR_DIDIT_WORKFLOW_ID
DIDIT_WEBHOOK_SECRET=YOUR_DIDIT_WEBHOOK_SECRET
DIDIT_API_BASE=https://verification.didit.me/v2
# Set to true only if you have real Didit API credentials above.
# false = shows a prominent "Approve KYC (demo)" button during onboarding.
NEXT_PUBLIC_DIDIT_CONFIGURED=false
ALLOW_DEMO_KYC=1

# FastAPI credit-scoring backend (Render). Unset = wallet-mode scoring falls back to rule-based.
CREDIT_BACKEND_URL=https://YOUR_SERVICE.onrender.com

# Pinata JWT for IPFS term-sheet anchoring. Unset = term sheets are signed but not pinned.
PINATA_JWT=
